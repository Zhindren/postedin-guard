# Base de datos propia de Guard (no la del portal)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/postedin_guard"

# Auth.js: generar con `npx auth secret` o `openssl rand -base64 32`
AUTH_SECRET=""
# URL pública de Guard, se usa en los enlaces de recuperación de contraseña
GUARD_PUBLIC_URL="http://localhost:3100"

# Dominios de correo permitidos para crear cuentas (separados por coma)
GUARD_ALLOWED_EMAIL_DOMAINS="postedin.com"

# Primer Líder Técnico que crea el seed (opcional si se usan los datos de demostración)
GUARD_SEED_ADMIN_EMAIL=""
GUARD_SEED_ADMIN_PASSWORD=""
GUARD_SEED_ADMIN_NAME=""
GUARD_SEED_ADMIN_LASTNAME=""

# Despliegue de demostración: "1" aplica migraciones y carga datos ficticios en cada build
# (scripts/vercel-build.mjs) y protege las cuentas de prueba @demo.test.
GUARD_DEMO=""

# Opcional: envío de correos de recuperación con Resend. Sin estas variables, el enlace
# se escribe en la consola del servidor (solo en desarrollo).
RESEND_API_KEY=""
GUARD_MAIL_FROM="Postedin Guard <guard@postedin.com>"

# Opcional: alarma en Slack cuando un análisis queda en rojo (BLOQUEADO o con críticos nuevos).
# Token de un bot de Slack (xoxb-…) y canal. Sin ambas variables queda apagada.
SLACK_BOT_TOKEN=""
GUARD_SLACK_CHANNEL=""
